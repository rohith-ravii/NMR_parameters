    "# ── User parameters ──\n",
    "# Base folder where all your gro/xtc files live\n",
    "data_dir = '/home/ebam/ravi1/phd/14A_apoa1/new_apporach/new/12_dimers/cubic_bigbox/charmm-gui-9583052457/gromacs/dired_fixed_orient/37_degree/res_50'\n",
    "\n",
    "# Just the filenames (no paths) — change these as needed\n",
    "gro_name  = 'res_newbox.gro'\n",
    "xtc_names = [\n",
    "'/home/ebam/ravi1/phd/14A_apoa1/new_apporach/new/12_dimers/cubic_bigbox/charmm-gui-9583052457/gromacs/dired_fixed_orient/37_degree/res_50/step5_1.xtc'\n",
