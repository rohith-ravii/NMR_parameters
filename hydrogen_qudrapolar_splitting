    "## Block 2: Build Peptide Segments & Selections\n",
    "\n",
    "- Generate start/end indices for each of the 12 dimeric peptides.\n",
    "- Select the protein atomgroup.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "def make_segments(plen, npairs):\n",
    "    segs = []\n",
    "    for i in range(npairs):\n",
    "        s1 = 2*i*plen\n",
    "        e1 = s1 + plen - 1\n",
    "        s2 = e1 + 1\n",
    "        e2 = s2 + plen - 1\n",
    "        segs.extend([(s1, e1), (s2, e2)])\n",
    "    return segs\n",
    "\n",
    "peptide_segments = make_segments(peptide_length, num_pairs)\n",
    "\n",
    "# Load universes\n",
    "u   = mda.Universe(gro_file, xtc_files)\n",
    "ref = mda.Universe(gro_file)\n",
    "\n",
    "# Protein atomgroup for later\n",
    "protein = u.select_atoms('protein')\n",
    "\n",
    "# Membrane normal (z-axis)\n",
    "membrane_normal = np.array([0.0, 0.0, 1.0])\n"
   ]
  },
