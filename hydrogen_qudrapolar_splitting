    "import numpy as np\n",
    "\n",
    "def compute_splitting(theta_deg, k=prefactor_khz):\n",
    "    \"\"\"\n",
    "    Compute the dipolar splitting for a given angle (in degrees),\n",
    "    ensuring the result is always non-negative.\n",
    "    \"\"\"\n",
    "    c2 = np.cos(np.radians(theta_deg))**2\n",
    "    raw = k * (3*c2 - 1) / 2.0\n",
    "    return (raw)  # force positivE\n",
    "\n",
    "angles, splittings = [], []\n",
    "\n",
    "for ts in u.trajectory:\n",
    "    for start, end in peptide_segments:\n",
    "        seg = protein[start:end+1]\n",
    "        if len(seg.residues) < 5:\n",
    "            continue\n",
    "\n",
    "        # pick the 5th residue (index 4) and its CA/CB atoms\n",
    "        res5 = seg.residues[4]\n",
    "        # print out its original PDB number (resid) and its three‐letter code (resname)\n",
    "        print(f\"Frame {ts.frame:4d} | segment {start:4d}-{end:4d} | \"\n",
    "              f\"picked resid {res5.resid:4d} ({res5.resname})\")\n",
    "\n",
    "        CA = res5.atoms.select_atoms('name CA')[0]\n",
    "        CB = res5.atoms.select_atoms('name CB')[0]\n",
    "\n",
    "        # compute vector and its norm\n",
    "        v = CB.position - CA.position\n",
    "        n = np.linalg.norm(v)\n",
    "        if n == 0:\n",
    "            continue\n",
    "\n",
    "        # angle between CA→CB vector and membrane normal\n",
    "        cos_t = np.dot(v, membrane_normal) / n\n",
    "        theta = np.degrees(np.arccos(np.clip(cos_t, -1, 1)))\n",
    "\n",
    "        # fold angle into [0, 90]\n",
    "        theta_fold = theta if theta <= 90 else 180 - theta\n",
    "\n",
    "        # record\n",
    "        angles.append(theta_fold)\n",
    "        splittings.append(compute_splitting(theta_fold))\n",
    "\n",
    "         # grab the residue ID & name\n",
    "        resid = res5.resid      # integer residue number\n",
    "        resname = res5.resname  # e.g. 'ALA', 'GLY', etc.\n",
    "        segid = res5.segid      # if you have segment IDs\n",
    "\n",
    "# convert to numpy arrays\n",
    "angles = np.array(angles)\n",
    "splittings = np.array(splittings)\n",
    "\n",
    "print(f\"Collected {len(splittings)} positive splittings.\")\n"
